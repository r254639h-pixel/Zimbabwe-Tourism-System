

    body{
    font-family : Arial, sans-serif;
    background-color: #f0f2f5;
    margin: 0;
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;
}


.team-card {
    width: 280px;
    border: 1px solid ;
    padding: 20px;
    text-align: center;
    border-radius: 10px;

    box-shadow: 0 4px 10px rgba(0,0,0,0.15);

    transition: box-shadow 0.3s ease;
}
member-photo {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
}

member-name {
    color: #1d3557;
    font-size: 24px;
    margin-bottom: 5px;
}


member-role {
    color: #555;
    font-size: 16px;
    font-style: italic;
}
contact-button {
    background-color: #007bff;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;

    transition: background-color 0.3s ease;
}

contact-button:hover {
    background-color: #0056b3;
}
team-card:hover {
    box-shadow: 0 10px 25px rgba(0,0,0,0.25);
}
